<?xml version="1.0" encoding="UTF-8"?>
<!--
  Installer for the PS Mobile Wallpaper PhoneBridge.

  Per-user, not per-machine, and that is deliberate:

    * The bridge keeps its config and auth token under the user's %AppData%\PSMobileWallpaper
      (spec §2.7 / §23), so a per-machine install would split state across accounts.
    * No elevation is needed, so the package can also drop the Photoshop panel straight into
      the UXP sideload folder without fighting per-machine-to-per-user redirection.

  The published executable is self-contained: no .NET runtime and no Adobe account required.
  Layout is staged by scripts/build-installer.ps1 into installer/wix/staging/.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="PS Mobile Wallpaper"
      Manufacturer="PS Mobile Wallpaper"
      Version="$(var.ProductVersion)"
      UpgradeCode="0EFA62FF-445D-4FCD-BD9F-D4605B20DAD2"
      Scope="perUser"
      Compressed="yes">

    <SummaryInformation
        Description="Local bridge connecting the PS Mobile Wallpaper Photoshop panel to an Android or HarmonyOS phone over USB."
        Manufacturer="PS Mobile Wallpaper" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of PS Mobile Wallpaper is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="PS Mobile Wallpaper">
        <Directory Id="HelpersFolder" Name="helpers" />
        <Directory Id="RuntimeFolder" Name="runtime">
          <Directory Id="RuntimeAdbFolder" Name="adb" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Where Photoshop looks for sideloaded UXP plugins. Deployed on install so the panel shows up
         in the Plug-ins menu after a Photoshop restart, with no Adobe account involved. -->
    <StandardDirectory Id="AppDataFolder">
      <Directory Id="AdobeFolder" Name="Adobe">
        <Directory Id="AdobeUxpFolder" Name="UXP">
          <Directory Id="AdobeUxpPluginsFolder" Name="Plugins">
            <Directory Id="AdobeUxpExternalFolder" Name="External">
              <Directory Id="PluginDeployFolder" Name="com.psmobilewallpaper.panel" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="PS Mobile Wallpaper" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="PS Mobile Wallpaper" Level="1">
      <ComponentGroupRef Id="BridgeComponents" />
      <ComponentGroupRef Id="AdbComponents" />
      <ComponentGroupRef Id="HelperComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
      <!-- Optional: some users load the panel through the UXP Developer Tool instead. -->
      <ComponentGroupRef Id="PluginComponents" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="BridgeComponents" Directory="INSTALLFOLDER">
      <Component Id="BridgeExecutable" Guid="E9F01764-2019-480A-8F07-DF27EF173F7C">
        <File Id="BridgeExe" Source="staging\app\PSMobileWallpaper.Api.exe" KeyPath="yes" />
      </Component>

      <Component Id="BridgeAppSettings" Guid="A1E29AEC-70F4-418B-8587-7A157D8DC706">
        <File Id="AppSettingsJson" Source="staging\app\appsettings.json" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- Installed on demand by the bridge when a device needs a wallpaper set. -->
    <ComponentGroup Id="HelperComponents" Directory="HelpersFolder">
      <Component Id="WallpaperHelperApk" Guid="8C2792BD-C8F4-4A7C-B712-497424ED9436">
        <File Id="HelperApk" Source="staging\app\helpers\psmw-wallpaper-helper.apk" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!--
      adb is bundled so a fresh machine can talk to an Android phone with no setup. It is
      Apache-2.0 and redistributable. hdc is NOT bundled: it ships with DevEco Studio and has no
      redistribution grant, so hdc.path stays a user setting.
    -->
    <ComponentGroup Id="AdbComponents" Directory="RuntimeAdbFolder">
      <Component Id="BundledAdb" Guid="14043AF3-0C5B-4BAE-A646-E689B179EBEB">
        <File Id="AdbExe" Source="staging\app\runtime\adb\adb.exe" KeyPath="yes" />
        <File Id="AdbWinApi" Source="staging\app\runtime\adb\AdbWinApi.dll" />
        <File Id="AdbWinUsbApi" Source="staging\app\runtime\adb\AdbWinUsbApi.dll" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="PluginComponents" Directory="PluginDeployFolder">
      <Component Id="PluginBundle" Guid="7B8D6992-CF39-4159-A0DE-DD48E880A6CE">
        <File Id="PluginManifest" Source="staging\plugin\manifest.json" KeyPath="yes" />
        <File Id="PluginMain" Source="staging\plugin\main.js" />
        <File Id="PluginHtml" Source="staging\plugin\index.html" />
        <File Id="PluginStyles" Source="staging\plugin\styles.css" />
        <RemoveFolder Id="RemovePluginFolder" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ShortcutComponents">
      <Component Id="StartMenuShortcut" Guid="E9C889D6-CC87-4972-A2BD-C1C2C5B2A87A"
                 Directory="ApplicationProgramsFolder">
        <Shortcut Id="StartMenuBridge"
                  Name="PS Mobile Wallpaper PhoneBridge"
                  Description="Start the local bridge that connects the Photoshop panel to your phone."
                  Target="[INSTALLFOLDER]PSMobileWallpaper.Api.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\PSMobileWallpaper" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcut" Guid="C3C15677-A764-4A1D-834D-3F3B52726231"
                 Directory="DesktopFolder">
        <Shortcut Id="DesktopBridge"
                  Name="PS Mobile Wallpaper PhoneBridge"
                  Description="Start the local bridge that connects the Photoshop panel to your phone."
                  Target="[INSTALLFOLDER]PSMobileWallpaper.Api.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\PSMobileWallpaper" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
